# ─── Base de datos ─────────────────────────────────────────────
# Local: mysql+pymysql://usuario:contraseña@localhost:3306/escapemanager
# Railway/prod: pega la URL completa que proporciona el proveedor
DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/escapemanager

# ─── JWT ───────────────────────────────────────────────────────
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_de_64_caracteres_hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── SMTP (envío de emails con Gmail) ──────────────────────────
# Crea una contraseña de aplicación en: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=EscapeManager<tu_email@gmail.com>

# ─── Entorno ────────────────────────────────────────────────────
# Valores: development | production
ENVIRONMENT=development
# Orígenes CORS permitidos (coma-separados)
ALLOWED_ORIGINS=http://localhost:8000
